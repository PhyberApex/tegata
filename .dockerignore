# Keep local dev state, secrets and build output out of the build context:
# a local `docker build` would otherwise bake them into the image.
.git
.github
.claude
.idea
.vscode
**/.DS_Store
**/node_modules
**/dist
**/coverage
**/.env*
!**/.env.example

